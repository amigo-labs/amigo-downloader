{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "amigo-downloader",
      "changelog-path": "CHANGELOG.md",
      "release-as": "0.1.0",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value.startsWith('amigo-'))].version"
        },
        {
          "type": "json",
          "path": "web-ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "tauri/tauri.conf.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
