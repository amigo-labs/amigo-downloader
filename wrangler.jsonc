/**
 * Cloudflare Worker "amigo-downloader": the address of Krake's former
 * marketing site. The site itself now lives on amigo-labs.dev/krake/,
 * built from docs/site/ (amigo-labs/website). This Worker only redirects
 * there, permanently, through Workers Static Assets: redirect/_redirects,
 * no Worker code and no build step.
 *
 * Workers Builds (Git integration) deploys it on every push to main with
 * its default commands; nothing in this repository needs credentials.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amigo-downloader",
  "compatibility_date": "2026-04-27",
  "assets": {
    "directory": "./redirect"
  }
}
