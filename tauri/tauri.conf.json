{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Krake",
  "mainBinaryName": "Krake",
  "version": "0.1.0",
  "identifier": "com.amigo-labs.krake",
  "build": {
    "frontendDist": "../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Krake",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:* http://localhost:*; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Fast, modular download manager",
    "longDescription": "Krake is a fast, modular download manager with HTTP multi-chunk downloads, Usenet support, a TypeScript plugin system, and a responsive web UI.",
    "linux": {
      "deb": {
        "depends": [
          "ca-certificates"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "krake",
          "amigo",
          "magnet"
        ]
      },
      "mobile": {
        "schemes": [
          "krake",
          "amigo"
        ]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/amigo-labs/amigo-krake/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwOTg1MDRDMTUzOEI4RjYKUldUMnVEZ1ZURkNZTUd1ZSsyS2grT05uc1U1aWdPazgvaVlsTlgrdm8zRHE1SEFIN0FTNjhMZksK"
    }
  }
}
